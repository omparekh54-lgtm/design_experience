APP_ENV=development

# LOCAL PHASE-1 BACKFILL
# Copy this file to .env and replace the line below with the exact Supabase
# Session Pooler connection string from Supabase > Connect > Session pooler.
# Never commit your real database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_PROJECT_REF=cxrkicqggsuylirzohqw

# PMS safety: keep paper-only execution.
LIVE_TRADING_ENABLED=false
EXECUTION_MODE=PAPER

# Required for authenticated operator mutations. Supply a private random key
# of at least 32 characters at deployment; never use a NEXT_PUBLIC_ variable.
OPS_API_KEY=
# Remote operator requests use HTTPS; explicit exception for reviewed private LANs.
PMS_ALLOW_PRIVATE_HTTP=0
# Restore rehearsal only: a separate EMPTY disposable database, never this source.
# PMS_RESTORE_TEST_URL=

# Optional services used by other project components.
REDIS_URL=redis://localhost:6379/0
FINSTACK_BASE_URL=
FINSTACK_API_KEY=
